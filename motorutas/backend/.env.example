# --- Local (Docker Compose) ---
# DATABASE_URL=postgresql+asyncpg://motorutas:motorutas@localhost:5432/motorutas

# --- Supabase: conexión directa (IPv6; requiere SSL) ---
# Sustituye YOUR_PASSWORD. Si la contraseña tiene caracteres especiales, codifícala en URL.
# DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@db.qaomixqlpeilkwlteamv.supabase.co:5432/postgres

# --- Supabase: Session Pooler (IPv4; proyecto qaomixqlpeilkwlteamv → eu-west-1) ---
# DATABASE_URL=postgresql+asyncpg://postgres.qaomixqlpeilkwlteamv:YOUR_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

